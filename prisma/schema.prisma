// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserType {
  CUSTOMER
  PROVIDER
}

enum Metro {
  SF
  LA
  VEGAS
  DALLAS
  NYC
  MIAMI
}

enum OrderStatus {
  PLACED
  CONFIRMED
  SHIPPED
  DELIVERED
  RETURN_INITIATED
  RETURN_RECEIVED
  COMPLETED
  CANCELLED
}

enum ListingStatus {
  AVAILABLE
  CLAIMED
}

model User {
  id                   String         @id @default(cuid())
  name                 String?
  email                String?        @unique
  emailVerified        DateTime?
  image                String?
  hashedPassword       String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  userType             UserType       @default(CUSTOMER)
  phone                String?
  businessName         String?
  verified             Boolean        @default(false)
  termsAcceptedAt      DateTime?
  termsAcceptedVersion String?
  accounts             Account[]
  listings             Listing[]      @relation("ownerListings")
  operatedListings     Listing[]      @relation("operatorListings")
  reservations         Reservation[]
  favoriteListings     UserFavorite[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Listing {
  id                String         @id @default(cuid())
  title             String
  description       String
  imageSrc          String
  videoSrc          String?
  createdAt         DateTime       @default(now())
  category          String
  roomCount         Int
  bathroomCount     Int
  guestCount        Int
  locationValue     String
  metro             Metro
  zipCode           String
  lat               Float
  lng               Float
  userId            String
  price             Int
  robotModelId      String?
  sku               String? // provider's physical-unit SKU (collected, not yet verified)
  skuImageSrc       String? // Cloudinary URL of the SKU-label photo
  isIndividualOwned Boolean        @default(false)
  status            ListingStatus?
  operatorId        String?
  claimedAt         DateTime?
  operator          User?          @relation("operatorListings", fields: [operatorId], references: [id])
  user              User           @relation("ownerListings", fields: [userId], references: [id], onDelete: Cascade)
  robotModel        RobotModel?    @relation(fields: [robotModelId], references: [id])
  reservations      Reservation[]
  favoritedBy       UserFavorite[]

  @@index([userId])
  @@index([metro])
  @@index([zipCode])
  @@index([robotModelId])
  @@index([operatorId])
  @@index([isIndividualOwned, status])
}

model Reservation {
  id              String             @id @default(cuid())
  userId          String
  listingId       String
  startDate       DateTime
  endDate         DateTime
  totalPrice      Int
  createdAt       DateTime           @default(now())
  stripeSessionId String?            @unique
  status          OrderStatus        @default(PLACED)
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing         Listing            @relation(fields: [listingId], references: [id], onDelete: Cascade)
  events          ReservationEvent[]

  @@index([listingId])
  @@index([userId])
  @@index([startDate])
  @@index([endDate])
}

model ReservationEvent {
  id            String      @id @default(cuid())
  reservationId String
  status        OrderStatus
  actorId       String
  note          String?
  createdAt     DateTime    @default(now())
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId])
}

model UserFavorite {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
  @@index([listingId])
}

// Stores a short-lived, hashed 6-digit code per email. `email` is unique so
// registering / resending upserts a single active code.
model EmailVerificationCode {
  id        String   @id @default(cuid())
  email     String   @unique
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
}

// Curated catalog of robots a provider can pick from when creating a listing.
// Seeded from data/robot-catalog/ via scripts/seed-robot-catalog.mjs.
model RobotModel {
  id              String       @id @default(cuid())
  slug            String       @unique // "<brand>-<model>"; stable upsert key + Cloudinary public_id
  brand           String
  model           String
  productName     String
  sku             String?
  description     String
  msrp            Int? // USD purchase price — reference only, never a listing's rental price
  priceHourly     Int? // USD per-hour rental price, null if not offered
  priceDaily      Int? // USD per-day rental price, null if not offered
  priceMonthly    Int? // USD per-month rental price, null if not offered
  useCase         String[] // zero or more of the 6 canonical use cases
  listable        Boolean      @default(false) // shows in the create-service robot picker
  serviceCategory String // one of the 3 canonical service categories
  capabilityTag   String // humanoid | quadruped | delivery | cleaning | reception | industrial | education
  imageUrl        String? // Cloudinary delivery URL, null if no source image
  needsReview     Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  listings        Listing[]
  robotAssets     RobotAsset[]

  @@index([brand])
  @@index([serviceCategory])
  @@index([model])
}

// Physical assets are independent of services, bookings and account deletion.
model RobotAsset {
  id               String        @id @default(cuid())
  modelId          String?
  model            RobotModel?   @relation(fields: [modelId], references: [id], onDelete: Restrict)
  serialNumber     String?
  serialKey        String?       @unique
  ownerName        String        @default("Hifivebot")
  location         String        @default("")
  notes            String        @default("")
  publicId         String?       @unique
  lifecycle        String        @default("DRAFT")
  condition        String        @default("AWAITING_INSPECTION")
  conditionEventAt DateTime?
  nameplateId      String?
  presentationId   String?
  registeredBrand  String?
  registeredModel  String?
  ownerConfirmedBy String?
  ownerConfirmedAt DateTime?
  insurance        String        @default("")
  tracker          String        @default("")
  version          Int           @default(1)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  audit            RobotAudit[]
  files            RobotFile[]
  records          RobotRecord[]
}

model RobotRecord {
  id               String       @id @default(cuid())
  robotId          String
  robot            RobotAsset   @relation(fields: [robotId], references: [id], onDelete: Restrict)
  kind             String
  data             Json
  eventAt          DateTime
  actorId          String
  actorEmail       String
  createdAt        DateTime     @default(now())
  supersedesId     String?      @unique
  supersedes       RobotRecord? @relation("recordRevision", fields: [supersedesId], references: [id], onDelete: Restrict)
  correction       RobotRecord? @relation("recordRevision")
  correctionReason String?

  @@index([robotId, createdAt])
}

model RobotFile {
  id        String     @id @default(cuid())
  robotId   String
  robot     RobotAsset @relation(fields: [robotId], references: [id], onDelete: Restrict)
  kind      String
  name      String
  mime      String
  bytes     Bytes
  createdAt DateTime   @default(now())

  @@index([robotId])
}

model RobotAudit {
  id         String     @id @default(cuid())
  robotId    String
  robot      RobotAsset @relation(fields: [robotId], references: [id], onDelete: Restrict)
  kind       String
  data       Json
  actorId    String
  actorEmail String
  createdAt  DateTime   @default(now())

  @@index([robotId, createdAt])
}

model RobotRequest {
  key      String @id
  hash     String
  response Json
}
