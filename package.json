{
  "name": "hifivebot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "registry:dev": "node scripts/registry-dev.mjs",
    "registry:prepare": "node scripts/registry-dev.mjs --prepare-only",
    "test:registry": "node scripts/registry-test.mjs",
    "test:registry:browser": "playwright test --config playwright.registry.config.ts",
    "supabase": "npx -y supabase@latest",
    "db:migrate:sql": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script > prisma/migrations/20260224103000_init_supabase_postgres/migration.sql",
    "db:migrate:data": "node scripts/migrate-mongo-to-postgres.js",
    "db:migrate:verify": "node scripts/verify-migration.js",
    "db:seed": "prisma db seed",
    "build:netlify": "prisma generate && node scripts/bundle-prisma-engines.mjs && node scripts/bundle-registry-native.mjs && next build && node scripts/prune-server-traces.mjs",
    "deploy:build": "env -u HTTP_PROXY -u HTTPS_PROXY -u http_proxy -u https_proxy npx netlify api createSiteBuild --data '{\"site_id\":\"79afde94-abbe-422c-ba4c-f68ab0100e62\",\"clear_cache\":false}'",
    "deploy:logs": "env -u HTTP_PROXY -u HTTPS_PROXY -u http_proxy -u https_proxy npx netlify logs:deploy",
    "deploy:status": "env -u HTTP_PROXY -u HTTPS_PROXY -u http_proxy -u https_proxy npx netlify api listSiteDeploys --data '{\"site_id\":\"79afde94-abbe-422c-ba4c-f68ab0100e62\",\"per_page\":10}'",
    "deploy:promote": "node scripts/promote-deploy.mjs",
    "deploy:rollback": "node scripts/promote-deploy.mjs --rollback",
    "deploy:local": "env -u HTTP_PROXY -u HTTPS_PROXY -u http_proxy -u https_proxy npx netlify build && env -u HTTP_PROXY -u HTTPS_PROXY -u http_proxy -u https_proxy npx netlify deploy --prod --site 79afde94-abbe-422c-ba4c-f68ab0100e62"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.5",
    "@prisma/client": "^4.12.0",
    "@react-email/render": "^2.0.4",
    "@supabase/supabase-js": "^2.98.0",
    "@types/date-fns": "^2.6.0",
    "@types/node": "18.15.11",
    "@types/react": "18.0.31",
    "@types/react-dom": "18.0.11",
    "axios": "^1.3.4",
    "bcryptjs": "^3.0.3",
    "date-fns": "^2.29.3",
    "eslint": "8.37.0",
    "eslint-config-next": "13.2.4",
    "framer-motion": "^10.10.0",
    "maplibre-gl": "^5.20.2",
    "mongodb": "^6.21.0",
    "next": "^13.5.6",
    "next-auth": "^4.20.1",
    "next-cloudinary": "^4.1.1",
    "qrcode": "^1.5.4",
    "query-string": "^8.1.0",
    "react": "18.2.0",
    "react-date-range": "^1.4.0",
    "react-dom": "18.2.0",
    "react-hook-form": "^7.43.9",
    "react-icons": "^5.6.0",
    "react-map-gl": "^8.1.0",
    "react-select": "^5.7.2",
    "react-toastify": "^9.1.2",
    "react-world-flags": "^1.5.1",
    "resend": "^6.9.4",
    "sharp": "^0.35.4",
    "stripe": "^20.4.1",
    "tailwind-scrollbar": "^3.0.0",
    "typescript": "5.0.3",
    "world-countries": "^4.0.0",
    "zod": "^3.25.76",
    "zustand": "^4.3.7"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.15.8",
    "@playwright/test": "^1.63.0",
    "@types/bcrypt": "^5.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/qrcode": "^1.5.5",
    "@types/react-date-range": "^1.4.4",
    "@types/react-world-flags": "^1.4.2",
    "adm-zip": "^0.5.17",
    "autoprefixer": "^10.4.14",
    "dotenv": "^17.3.1",
    "postcss": "^8.4.21",
    "prisma": "^4.12.0",
    "tailwindcss": "^3.3.1",
    "tsx": "^4.20.5",
    "vitest": "^2.1.9"
  }
}
