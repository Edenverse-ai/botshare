# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Git worktrees
.worktrees/

# Large video assets (host on Cloudinary instead)
/public/videos/*.mp4
/public/videos/*.mov
/public/videos/*.webm

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/.next.dev-cache-backup-*
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*.local
.env

# vercel
.vercel

# supabase cli local state
supabase/.temp
supabase/.branches

# typescript
*.tsbuildinfo
next-env.d.ts

# netlify
# .netlify/state.json
# .netlify/functions-internal/
# .netlify/edge-functions-dist/
.netlify/
deno.lock

# Claude Agent
/.superpowers/

# generated data script caches (raw Census downloads; outputs in data/ are committed)
/scripts/.cache/

# Playwright MCP traces / smoke screenshots
/.playwright-mcp/
/smoke-*.png
/.registry-test-results/
# Robot catalog: extracted images are regenerable, keep out of git
data/robot-catalog/robot-images/
